<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# API's hardware-in-the-loop suite: see ../README.md. Built and run by
       ../run-csharp-hil.ps1 against the ShimmerAPI and Shimmer32FeetAPI in this checkout. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>ShimmerApiHil</RootNamespace>
    <AssemblyName>ShimmerApiHil</AssemblyName>
    <Prefer32Bit>false</Prefer32Bit>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\ShimmerAPI\ShimmerAPI\ShimmerAPI.csproj" />
    <ProjectReference Include="..\..\..\Shimmer32FeetAPI\Shimmer32FeetAPI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Tomlyn" Version="0.17.0" />
  </ItemGroup>

</Project>
